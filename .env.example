# --- API de Festy ---
PORT=4000
# Conexión como rol `authenticator` (en el VPS la clave es POSTGRES_PASSWORD).
DATABASE_URL=postgresql://authenticator:postgres@127.0.0.1:64322/postgres
# URL pública de Supabase local (sin /auth/v1): de ahí se toman las claves JWKS.
# En el VPS se usa AUTH_JWKS_URL + JWT_SECRET (ver despliegue/docker-compose.yml).
AUTH_URL=http://127.0.0.1:64321
AUTH_JWKS_URL=
# Solo si GoTrue firma con HS256 (VPS). Con la CLI local se usa JWKS y queda vacío.
JWT_SECRET=
# Opcional: exige este emisor en el token (ej. https://api.tudominio.com/auth/v1)
JWT_ISSUER=
# Orígenes del front separados por coma (Vercel, app Android, local).
ORIGENES_PERMITIDOS=http://localhost:5173,https://localhost,capacitor://localhost
# JSON de la cuenta de servicio de Firebase en una sola línea. Vacío = sin push.
FIREBASE_SERVICE_ACCOUNT=
# true = no programa el envío de push (útil en pruebas).
DESACTIVAR_TAREAS=false
