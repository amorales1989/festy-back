# Entrada interna de Festy en Coolify. Traefik (de Coolify) termina el HTTPS y
# reenvía acá; solo se publican /api (API de Festy) y /auth/v1 (GoTrue).
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8000 {
	encode gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	# CORS de la autenticación (GoTrue no lo maneja solo): únicamente el front
	# (URL_FRONT) y la app Android. La API de Festy maneja su propio CORS.
	@cors_auth {
		path /auth/v1/*
		# Una línea por origen (varios valores en una misma línea no funcionan).
		header Origin {$URL_FRONT}
		header Origin https://localhost
		header Origin capacitor://localhost
		header Origin http://localhost
	}
	header @cors_auth {
		Access-Control-Allow-Origin "{http.request.header.Origin}"
		Access-Control-Allow-Headers "authorization, apikey, content-type, x-client-info, x-supabase-api-version"
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Access-Control-Max-Age "86400"
		Vary Origin
		defer
	}
	handle_path /auth/v1/* {
		@preflight method OPTIONS
		respond @preflight 204
		reverse_proxy auth:9999
	}
	handle /api/* {
		reverse_proxy api:4000
	}
	handle /salud {
		reverse_proxy api:4000
	}
	handle {
		respond "No encontrado" 404
	}
}
