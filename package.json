{
  "name": "festy-back",
  "version": "1.0.0",
  "description": "API de Festy: Node/Express sobre stored procedures de PostgreSQL",
  "main": "src/index.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "test": "node --test tests/*.test.js",
    "test:db": "supabase test db",
    "db:reset": "supabase db reset",
    "db:tipos": "supabase gen types typescript --local --schema public > ../festy/src/types/database.ts",
    "demo": "bash scripts/demo.sh",
    "test:concurrencia": "bash scripts/prueba_concurrencia.sh"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1"
  }
}
